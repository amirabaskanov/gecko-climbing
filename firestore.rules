rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidUsername(username) {
      return username is string && username.matches('^[a-z0-9_]{3,20}$');
    }

    function usernameReservedBy(uid, username) {
      return getAfter(/databases/$(database)/documents/usernames/$(username)).data.uid == uid;
    }

    function usernameUnchanged() {
      return request.resource.data.username == resource.data.username;
    }

    function ownerUserWriteIsValid(uid) {
      return isOwner(uid) &&
        isValidUsername(request.resource.data.username) &&
        (
          !exists(/databases/$(database)/documents/users/$(uid)) ||
          usernameUnchanged() ||
          usernameReservedBy(uid, request.resource.data.username)
        );
    }

    // Users
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if ownerUserWriteIsValid(uid) &&
        usernameReservedBy(uid, request.resource.data.username);
      // Owners can edit their profile only when username ownership is valid.
      // Other users can only update session-stat counters.
      // followersCount / followingCount are server-owned (the onFollowChanged
      // Cloud Function maintains them via the Admin SDK, which bypasses these
      // rules) — no client may write them, so counts can't be spoofed.
      allow update: if isSignedIn() &&
        (ownerUserWriteIsValid(uid) ||
         // Owners may always manage their block list, independent of any
         // username-validity check — moderation must never be blocked.
         (isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blockedUserIds'])) ||
         (isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['totalSessions', 'totalClimbs', 'highestGrade', 'highestGradeNumeric']
          )));
      // Owners may delete their own profile (App Store Guideline 5.1.1(v)
      // account deletion).
      allow delete: if isOwner(uid);

      match /following/{targetUid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid);
      }

      match /followers/{followerUid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == followerUid;
      }
    }

    // Username reservations. Document IDs are normalized usernames and keep
    // profile handles unique across users.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        isValidUsername(username) &&
        request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update: if isSignedIn() &&
        isValidUsername(username) &&
        request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow delete: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        (
          // Account deletion: the user doc is already gone, so there's no
          // handle left to protect.
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          // Username change: only release the old handle once the user doc
          // claims a different one.
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username != username
        );
    }

    // Sessions
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;

      match /climbs/{climbId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
      }
    }

    // Posts — read requires auth only; feed filtering is done in-app via followed-user queries
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Owner can update anything; other users can only update like/comment counters
      allow update: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(
           ['likesCount', 'commentsCount']
         ));
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      match /likes/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      }
    }

    // Feedback — users can only create, never read/update/delete their own
    match /feedback/{feedbackId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Reports — moderation reports (App Store Guideline 1.2). Users can only
    // create their own; triage happens server-side via the Firebase console.
    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterUserId == request.auth.uid;
    }

    // Server-only collections — notifications backend (Cloud Functions)
    // Admin SDK bypasses these rules; clients must never touch these.
    match /notificationBatches/{bucketKey} {
      allow read, write: if false;
    }

    match /rateLimits/{uid} {
      allow read, write: if false;
    }
  }
}
